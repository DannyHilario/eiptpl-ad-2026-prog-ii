# Ejercicios: solo se versiona el código fuente, los README de cada etapa, y no
# los binarios compilados (linux/mac generan un ejecutable sin extensión con el
# mismo nombre del .cpp). Se admite cualquier nivel de subcarpetas
# (ej. ejercicios/etapa-0-repaso/).
ejercicios/*
ejercicios/**/*
!ejercicios/**/
!ejercicios/**/*.cpp
!ejercicios/**/*.h
!ejercicios/**/*.hpp
!ejercicios/**/README.md

# Exámenes: solo se publican los programas originales (.cpp) del ejercicio 1 del
# medio término; los enunciados (.md/.pdf) que crea el generador no se publican.
examenes/*
examenes/**/*
!examenes/**/
!examenes/**/*.cpp
